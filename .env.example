# Copy this file to ".env.local" and fill in your values.
# Leave the Supabase lines empty to run in demo mode (no account needed).

# Supabase → Project Settings → API (or the "Connect" button)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional
VITE_HOUSEHOLD=demo-family
VITE_SENIOR_NAME=Doña Luz
# Minutes to wait before telling the caregiver a dose was missed (2 is good for a live demo)
VITE_GRACE_MINUTES=2
